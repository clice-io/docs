{
  "name": "@clice-io/translate",
  "version": "0.0.0",
  "description": "Keep an English and a Chinese documentation tree aligned, segment by segment",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clice-io/docs.git",
    "directory": "tools/translations"
  },
  "type": "module",
  "bin": {
    "clice-translate": "dist/cli.js"
  },
  "files": [
    "dist",
    "RULES.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
