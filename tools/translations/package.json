    "check": "npm run typecheck && npm run lint",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "p-limit": "^7.1.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.1",
    "@types/unist": "^3.0.3",
    "eslint": "^10.8.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
