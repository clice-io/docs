{
  "id": "compile/encoding/01_byte_order_mark",
  "topic": "compile",
  "subtopic": "encoding",
  "title": "Byte order marks",
  "summary": "Files saved as UTF-8 with a byte order mark work like any other",
  "prose": "Positions skip the mark, as the editor shows the file, and clice reads the file as the compiler does: data it embeds keeps its bytes.",
  "status": "supported",
  "issues": [],
