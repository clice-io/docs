{
  "id": "navigation/constructor_calls/03_new_expressions",
  "topic": "navigation",
  "subtopic": "constructor_calls",
  "title": "`new` expressions",
  "summary": "The class name a `new` allocates leads to the constructor it runs",
  "prose": "In `new Widget(1)`, `new Widget{2}` and `new Widget`, the class's name\nanswers the constructor that builds the object, and go-to-type-definition\nthe class. An array's element type names the class alone.",
  "status": "supported",
