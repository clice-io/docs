{
  "id": "code_completion/member_access/22_constructor_initializers",
  "topic": "code_completion",
  "subtopic": "member_access",
  "title": "Constructor initializers",
  "summary": "After a constructor's `:` the bases and members not initialized yet are offered, bases first, in declaration order",
  "prose": "The one to initialize next comes first, though in a class with a virtual base it may not be. Each inserts the parameters of its constructor as placeholders, and a base or member with several constructors is one item, its parentheses left empty, unless overloads are listed apart. Names of other namespaces are not offered there.",
  "status": "partial",
  "issues": [],
  "files": [
    {
      "path": "main.cpp",
      "text": "namespace other {\nint width_limit;\n}\n\n/// What every widget is built on.\nstruct Base {\n    Base(int seed);\n};\n\nstruct Point {\n    int x;\n    int y;\n};\n\n/// A name a person reads.\nstruct Name {\n    Name();\n    Name(const char* text);\n};\n\ntemplate <typename T>\nstruct Tagged {\n    Tagged(T tag);\n};\n\nstruct Widget : Base {\n    int width;\n\n    /// The title of the window.\n    Name name;\n\n    Point origin;\n\n    Widget() :  {}\n\n    Widget(int seed) : Base(seed),  {}\n\n    Widget(long);\n    Widget(short);\n    Widget(char);\n    Widget(float);\n    Widget(double);\n    Widget(unsigned);\n};\n\nstruct Label : Tagged<int> {\n    Label() : Tagged<int>(1) {}\n\n    Label(int) : Tag{1} {}\n\n    Label(long) : Tagged <int>(1) {}\n\n    Label(short) : Tagged< int >(1) {}\n};\n\nWidget::Widget(long) :  {}\n\nWidget::Widget(double) : width(1),  {}\n\nWidget::Widget(short) : wid(1) {}\n\nWidget::Widget(float) : Base(1), wid{1} {}\n\nWidget::Widget(unsigned) : Base(1), wid {1}, name{} {}\n\ntemplate <typename T>\nstruct Holder : T {\n    T value;\n\n    Holder() :  {}\n};\n\ntemplate <typename T>\nstruct Outer {\n    using Base = T;\n\n    template <typename U>\n    struct Inner {\n        Inner(U value);\n    };\n\n    struct Derived : Base {\n        int Base;\n\n        Derived() :  {}\n    };\n};\n\nstruct Wrapped : Outer<int>::Inner<double> {\n    Wrapped() : Inn<double>(1) {}\n\n    Wrapped(int) : Out<int>::Inner<double>(1) {}\n};\n\n/// What a field grows from.\nstruct Grain {\n    Grain(int value);\n};\n\nstruct Planted : Grain {\n    /// A member named after its base.\n    int Grain;\n\n    Planted() :  {}\n};\n\nnamespace ns {\nstruct Seed {\n    Seed(int value);\n};\n}  // namespace ns\n\nstruct Seeded : ns::Seed {\n    Seeded() : n::Seed(1) {}\n};\n\nstruct Value {\n    bool is_int;\n\n    union {\n        int integer;\n        double real;\n    };\n\n    Value() :  {}\n};\n\ntemplate <typename... Bases>\nstruct Mixed : Bases... {\n    Mixed() : Bas{}... {}\n};\n\nWidget::Widget(char) : wi {}\n",
