{
  "id": "code_completion/functions_snippets/12_objective_c_methods",
  "topic": "code_completion",
  "subtopic": "functions_snippets",
  "title": "Objective-C methods",
  "summary": "A message completes its selector with a placeholder for each argument, from the piece the cursor is at; in a message to `super` the method being written passes its own arguments on. A method declared in an implementation gets its whole declaration, and after a dot a method taking no argument reads as a property",
  "prose": "The list shows a selector's first piece, the rest as its signature. With `delimiters` the arguments are empty tab stops; with `none`, and where an argument is written already, the piece alone.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "main.m",
      "text": "__attribute__((objc_root_class))\n@interface Shape\n@property int width;\n+ (instancetype)shapeWithWidth:(int)width;\n+ (Shape *)unit;\n- (void)moveToX:(int)x;\n- (void)moveToX:(int)x y:(int)y;\n- (int)area;\n@end\n\n@interface Square : Shape\n@end\n\nvoid use(Shape *shape) {\n    [shape mo];\n    [shape ar];\n    [shape moveToX:1 y];\n    [shape mo:1];\n    [Shape sha];\n    int area = shape.ar;\n    Shape *unit = Shape.un;\n    SEL moving = @selector(mo);\n    SEL renamed = @selector(mo:y:);\n}\n\n@implementation Square\n- (void)moveToX:(int)x y:(int)y {\n    [super mo];\n    [super mo:x y:y];\n}\n- (void)mo {\n}\n- (void)moveToX:(int)x y {\n}\n- ar {\n}\n@end\n\n@protocol Drawable\n- (void)draw;\n@end\n\n@compatibility_alias Stylus Shape;\n\nvoid sketch(Shape *shape) {\n    [Sha unit];\n    id<Dra> drawable;\n    int wide = shape.wi;\n    [Sty unit];\n    SEL later = @selector(moveToX:y);\n}\n",
